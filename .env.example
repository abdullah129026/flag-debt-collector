# Copy to .env.local for local dev. Never commit a real value.
# Supabase project (created in phase-6 deploy): project URL + keys from
# the Supabase dashboard, API settings. Legacy keys work; the new-style
# secret key (sb_secret_...) is NOT accepted by this project's gateway
# yet (project 4 gotcha, 2026-11-13), so use the legacy service_role JWT.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Shared bearer secret between pg_cron and /api/cron/* routes. Generate
# with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Set the same value in Vercel env vars and in the pg_cron setup script.
CRON_SECRET=

# Optional. A GitHub personal access token (read-only, public data) raises
# the GitHub API limit for the pre-clone size check and the no-git age
# fallback from 60 to 5,000 requests/hour. Without it the scan still works
# for small repos; the size check falls back to cloning with caps enforced
# after checkout.
GITHUB_TOKEN=

# Optional. PostHog host + key for analytics (phase-4). Cookieless config,
# session replay off. Leave unset and the site sends no analytics.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Optional. Which age source the scanner records: github-api (default).
# The runtime has no git binary, so age always comes from the host API
# (GitHub or GitLab commits per file). Ages are labeled "approx", rename
# detection is off, flags cap at possible. The variable stays as the
# recorded mode; the code no longer branches on it.
SCANNER_AGE_SOURCE=github-api
